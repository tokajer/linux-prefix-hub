# AppRun -- entry point inside the AppImage.
#
# $APPIMAGE is set by the AppImage runtime and points at the .AppImage file at
# its current (possibly wandering) location. core/integrate.py uses it to copy
# itself to the fixed location.
#
# Self-heal: on every NORMAL start (no special mode) make sure the shims, the
# systemd unit and the menu entry exist and point at the fixed location. That
# way the integration survives even if the user launched us from /tmp once.

set -u
HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"

# Bundled Python (python-appimage layout), with graceful fallbacks.
PYTHON=""
for candidate in "${HERE}"/opt/python*/bin/python3.* "${HERE}/usr/bin/python3"; do
  if [ -x "${candidate}" ]; then
    PYTHON="${candidate}"
    break
  fi
done
if [ -n "${PYTHON}" ] && [ -d "$(dirname "$(dirname "${PYTHON}")")/lib" ]; then
  export PYTHONHOME="$(dirname "$(dirname "${PYTHON}")")"
fi
[ -x "${PYTHON}" ] || PYTHON="$(command -v python3)"

# Second home for the app code, used when it is not installed into the
# bundled interpreter's site-packages. Appending an unset PYTHONPATH would
# leave a trailing colon -- an empty entry means "the current directory", and
# for --wrapper that directory belongs to the game.
export PYTHONPATH="${HERE}/usr/lib/python${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONDONTWRITEBYTECODE=1

# Pass the shim modes straight through: these run on every game launch and
# must not pay for the self-heal round trip.
case "${1:-}" in
  --wrapper|--hook|--daemon)
    exec "${PYTHON}" -m linux_prefix_hub "$@"
    ;;
esac

# Normal start: quietly self-heal, then run the requested mode / the UI.
"${PYTHON}" -m linux_prefix_hub --integrate >/dev/null 2>&1 || true
exec "${PYTHON}" -m linux_prefix_hub "$@"
