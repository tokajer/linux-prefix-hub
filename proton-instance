#!/usr/bin/env bash
# proton-instance - per-game Proton instances with persistent env injection
#
# Creates a hardlinked clone of an installed Proton build and injects a
# per-game user_settings.py. Env profiles live outside the instance, so
# rebuilding onto a newer base never loses them.
#
# Usage:
#   proton-instance create <game> [--base <name|family>]
#   proton-instance edit   <game>
#   proton-instance update <game> [--base <name>]
#   proton-instance update-all
#   proton-instance list
#   proton-instance remove <game>
#
# --base takes an exact build name (GE-Proton10-15) or a family prefix
# (GE-Proton, Proton-Tkg) that resolves to the newest of that family.
# The choice is remembered per game, so update keeps the same family.
#
# Env profiles: ~/.config/proton-instances/<game>.env  (KEY=value per line)

set -euo pipefail

TOOLS_DIR="${STEAM_COMPAT_TOOLS_DIR:-$HOME/.steam/root/compatibilitytools.d}"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/proton-instances"
PREFIX_NAME="Proton-Instance"
# Family used when --base is not given. Override with PROTON_INSTANCE_FAMILY.
DEFAULT_FAMILY="${PROTON_INSTANCE_FAMILY:-GE-Proton}"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }

# Newest installed Proton matching a name prefix, excluding our own clones.
# Sorting is version-aware but only within one family, so a family prefix
# ("GE-Proton") must be given to avoid comparing across vendors -- plain
# sort -V ranks Proton-Tkg above GE-Proton on the leading letter alone.
detect_base() {
  local pattern=${1:-$DEFAULT_FAMILY}
  local d best=""
  for d in "$TOOLS_DIR"/*/; do
    d=${d%/}
    local n=${d##*/}
    [[ $n == "$PREFIX_NAME"-* ]] && continue
    [[ -x $d/proton ]] || continue
    [[ $n == $pattern* ]] || continue
    if [[ -z $best ]]; then best=$n; continue; fi
    [[ $(printf '%s\n%s\n' "$best" "$n" | sort -V | tail -1) == "$n" ]] && best=$n
  done
  [[ -n $best ]] || die "no Proton build matching '$pattern*' in $TOOLS_DIR
available: $(cd "$TOOLS_DIR" && ls -d */ 2>/dev/null | tr -d / | tr '\n' ' ')"
  printf '%s' "$best"
}

# A --base value is either an exact directory name or a family prefix.
resolve_base() {
  local want=$1
  [[ -x $TOOLS_DIR/$want/proton ]] && { printf '%s' "$want"; return; }
  detect_base "$want"
}

base_file() { printf '%s/%s.base' "$CONF_DIR" "$1"; }

instance_dir() { printf '%s/%s-%s' "$TOOLS_DIR" "$PREFIX_NAME" "$1"; }
env_file()     { printf '%s/%s.env' "$CONF_DIR" "$1"; }

default_env() {
  cat <<'EOF'
# Env injected into the Proton runtime for this game.
# Runs INSIDE the Steam Linux Runtime container, so pressure-vessel
# cannot filter these out. One KEY=value per line, no export, no quotes.

MANGOHUD=1
MANGOHUD_CONFIG=fps,frametime,gpu_stats,cpu_stats,vram,ram,position=top-left

# Fallback HUD - lives in DXVK itself, works even when the 32-bit
# MangoHud layer is missing from the container.
DXVK_HUD=fps,frametime

# DXVK_CONFIG_FILE=/path/to/dxvk.conf
# DXVK_STATE_CACHE_PATH=/path/to/cache
EOF
}

# Turn the .env profile into a user_settings.py dict.
write_user_settings() {
  local game=$1 dir=$2 ef
  ef=$(env_file "$game")

  # MUST unlink first: cp -al hardlinks the tree, so a plain redirect
  # would truncate the file inside the base Proton install too.
  rm -f "$dir/user_settings.py"

  {
    printf '# generated by proton-instance for %s - edits here are overwritten\n' "$game"
    printf 'user_settings = {\n'
    while IFS= read -r line; do
      line=${line%%$'\r'}
      [[ -z ${line// } ]] && continue
      [[ $line == \#* ]] && continue
      [[ $line == *=* ]] || continue
      local k=${line%%=*} v=${line#*=}
      k=${k## }; k=${k%% }; v=${v## }
      # Backslashes first, then quotes: a Windows path like
      # C:\Users\... would otherwise hit Python's \U escape and abort.
      v=${v//\\/\\\\}
      printf '    "%s": "%s",\n' "$k" "${v//\"/\\\"}"
    done < "$ef"
    printf '}\n'
  } > "$dir/user_settings.py"
}

# Give the clone its own identity so Steam does not collide it with the base.
# The internal-name line carries a trailing "// Internal name of this tool"
# comment in GE builds, so match structurally: the lone quoted token inside
# the compat_tools block, rather than trying to pattern-match the version.
rewrite_vdf() {
  local dir=$1 name=$2 vdf=$dir/compatibilitytool.vdf
  [[ -f $vdf ]] || return 0
  rm -f "$vdf.tmp"
  awk -v name="$name" '
    /"compat_tools"/ { in_ct = 1; print; next }
    in_ct && !done && /^[[:space:]]*"[^"]+"[[:space:]]*(\/\/.*)?$/ {
      match($0, /^[[:space:]]*/)
      indent = substr($0, 1, RLENGTH)
      rest = ""
      if (match($0, /\/\/.*$/)) rest = " " substr($0, RSTART)
      print indent "\"" name "\"" rest
      done = 1
      next
    }
    /"display_name"/ {
      match($0, /^[[:space:]]*/)
      print substr($0, 1, RLENGTH) "\"display_name\" \"" name "\""
      next
    }
    { print }
  ' "$vdf" > "$vdf.tmp"
  rm -f "$vdf"          # unlink before replacing, same hardlink reason
  mv "$vdf.tmp" "$vdf"
}

build() {
  local game=$1 base=$2 dir
  dir=$(instance_dir "$game")
  [[ -x $TOOLS_DIR/$base/proton ]] || die "base '$base' not found in $TOOLS_DIR"

  if [[ -d $dir ]]; then
    info "removing old instance"
    rm -rf "$dir"
  fi

  info "cloning $base -> ${dir##*/}"
  if ! cp -al "$TOOLS_DIR/$base" "$dir" 2>/dev/null; then
    info "hardlink clone failed (cross-device?), copying instead"
    cp -a "$TOOLS_DIR/$base" "$dir"
  fi

  rewrite_vdf "$dir" "$PREFIX_NAME-$game"
  write_user_settings "$game" "$dir"
  printf '%s\n' "$base" > "$dir/.proton-instance-base"

  info "ready: $dir"
}

cmd_create() {
  local game=${1:?usage: create <game>}; shift || true
  local base=""
  [[ ${1:-} == --base ]] && base=${2:?--base needs a value}

  mkdir -p "$CONF_DIR"
  local ef; ef=$(env_file "$game")
  [[ -f $ef ]] || { default_env > "$ef"; info "created env profile $ef"; }

  if [[ -n $base ]]; then
    printf '%s\n' "$base" > "$(base_file "$game")"
  else
    base=$(cat "$(base_file "$game")" 2>/dev/null || printf '%s' "$DEFAULT_FAMILY")
  fi
  base=$(resolve_base "$base")
  build "$game" "$base"

  cat <<EOF

Point the game's launcher at:
  $(instance_dir "$game")

Edit env any time:  proton-instance edit $game
EOF
}

cmd_edit() {
  local game=${1:?usage: edit <game>} ef
  ef=$(env_file "$game")
  [[ -f $ef ]] || die "no profile for '$game' - run: proton-instance create $game"
  "${EDITOR:-nano}" "$ef"
  local dir; dir=$(instance_dir "$game")
  [[ -d $dir ]] && { write_user_settings "$game" "$dir"; info "applied to instance"; }
}

cmd_update() {
  local game=${1:?usage: update <game>}; shift || true
  local base=""
  [[ ${1:-} == --base ]] && base=${2:?--base needs a value}
  [[ -f $(env_file "$game") ]] || die "no profile for '$game'"
  if [[ -n $base ]]; then
    printf '%s\n' "$base" > "$(base_file "$game")"
  else
    base=$(cat "$(base_file "$game")" 2>/dev/null || printf '%s' "$DEFAULT_FAMILY")
  fi
  base=$(resolve_base "$base")
  build "$game" "$base"
}

cmd_update_all() {
  local ef game base
  shopt -s nullglob
  for ef in "$CONF_DIR"/*.env; do
    game=${ef##*/}; game=${game%.env}
    base=$(cat "$(base_file "$game")" 2>/dev/null || printf '%s' "$DEFAULT_FAMILY")
    base=$(resolve_base "$base")
    info "$game -> $base"
    build "$game" "$base"
  done
}

cmd_list() {
  shopt -s nullglob
  local ef game dir base
  printf '%-20s %-22s %s\n' GAME BASE STATUS
  for ef in "$CONF_DIR"/*.env; do
    game=${ef##*/}; game=${game%.env}
    dir=$(instance_dir "$game")
    if [[ -d $dir ]]; then
      base=$(cat "$dir/.proton-instance-base" 2>/dev/null || echo '?')
      printf '%-20s %-22s %s\n' "$game" "$base" built
    else
      printf '%-20s %-22s %s\n' "$game" - "profile only"
    fi
  done
}

cmd_remove() {
  local game=${1:?usage: remove <game>} dir
  dir=$(instance_dir "$game")
  [[ -d $dir ]] && { rm -rf "$dir"; info "removed $dir"; }
  info "kept env profile $(env_file "$game")"
}

case "${1:-}" in
  create)     shift; cmd_create "$@" ;;
  edit)       shift; cmd_edit "$@" ;;
  update)     shift; cmd_update "$@" ;;
  update-all) shift; cmd_update_all "$@" ;;
  list)       shift; cmd_list "$@" ;;
  remove)     shift; cmd_remove "$@" ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \?//' ; exit 1 ;;
esac
